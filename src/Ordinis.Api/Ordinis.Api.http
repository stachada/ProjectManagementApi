@Ordinis.Api_HostAddress = http://localhost:5084
@contentType = application/json

# Idempotency-Key reused across every create-style POST below - each hits a different
# route, and the cache key is scoped per {method}:{path}:{key}, so the same literal is
# safe to reuse across all of them (see docs/IDEMPOTENCY.md). NOTE: if you re-run this
# whole file a second time without restarting the API or bumping this value, every
# create below will replay its first run's cached response instead of creating a fresh
# resource - generate a new GUID before a second full run.
@idempotencyKey = 0198f3c2-9e2b-7c31-8b2a-4e6f1a2d3c4b

### Health check
GET {{Ordinis.Api_HostAddress}}/health

###
# Create an organization. Copy the "id" from the response into @organizationId below
# to run the rest of the requests against it. Organization is not RowVersion-guarded
# (see docs/CONCURRENCY.md's "what's guarded" table), so no If-Match header here.
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "name": "Rocket Science Inc.",
  "description": "Test org"
}

###
@organizationId = 019F9891-E792-7C15-BA32-892EEA1FD225

### Get an organization by ID
GET {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}

### Get an organization by ID - not found (random GUID)
GET {{Ordinis.Api_HostAddress}}/api/v1/organizations/11111111-1111-1111-1111-111111111111

### List an organization's projects (paged)
GET {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}/projects?page=1&pageSize=20&sortBy=createdAt&sortDescending=false

### Rename + update description
PUT {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}
Content-Type: {{contentType}}

{
  "name": "Acme Corporation",
  "description": "Updated description"
}

### Suspend
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}/suspend

### Suspend again - expect 422 organization.already-suspended
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}/suspend

### Reactivate
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}/reactivate

### Reactivate again - expect 422 organization.already-active
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations/{{organizationId}}/reactivate

### Create with empty name - expect 422 validation errors
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}

{
  "name": ""
}

###
# Idempotency-Key replay and conflict (docs/IDEMPOTENCY.md), exercised against
# organizations since they need no parent entity. Uses its own key, separate from
# @idempotencyKey above, so it doesn't interact with the create at the top of this file.
@replayKey = 0198f3c2-1111-7c31-8b2a-4e6f1a2d3c4b

### First attempt - creates the organization
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}
Idempotency-Key: {{replayKey}}

{
  "name": "Idempotency Test Co"
}

### Retry with the SAME key and the SAME body - replayed, not re-executed. Expect 201
# with a body/Location identical to the request above, and only one "Idempotency Test
# Co" organization ever created in the database.
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}
Idempotency-Key: {{replayKey}}

{
  "name": "Idempotency Test Co"
}

### Retry with the SAME key and a DIFFERENT body - expect 409 Conflict
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}
Idempotency-Key: {{replayKey}}

{
  "name": "Idempotency Test Co - Renamed"
}

### Retry with NO key at all - expect 201, a genuinely new organization
# (only the duplicate-slug validator would reject this, which is an unrelated 422 -
# not applicable here since the name differs from every request above)
POST {{Ordinis.Api_HostAddress}}/api/v1/organizations
Content-Type: {{contentType}}

{
  "name": "Idempotency Test Co - No Key"
}

###
# UsersController requests below reuse @organizationId from above.
# Create two users - the first becomes @createdByUserId (used to create the
# project below), the second becomes @memberUserId (added as a project member).
# User is not RowVersion-guarded, so no If-Match header on these.
POST {{Ordinis.Api_HostAddress}}/api/v1/users
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "organizationId": "{{organizationId}}",
  "displayName": "Alice Admin",
  "email": "alice.admin@example.com",
  "password": "SuperSecret123",
  "orgRole": 2
}

###
@createdByUserId = 00000000-0000-0000-0000-000000000000

### Create a second user. Copy the "id" from the response into @memberUserId below.
POST {{Ordinis.Api_HostAddress}}/api/v1/users
Content-Type: {{contentType}}
Idempotency-Key: {{idempotencyKey}}

{
  "organizationId": "{{organizationId}}",
  "displayName": "Bob Member",
  "email": "bob.member@example.com",
  "password": "SuperSecret123",
  "orgRole": 1
}

