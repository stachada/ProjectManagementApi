<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test infrastructure (not a test project): the in-process API host backed by a
    disposable SQL Server container. Referenced by Ordinis.IntegrationTests and
    Ordinis.AcceptanceTests so both boot the real API exactly the same way.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- SSH.NET pulled in transitively by Testcontainers for remote-Docker-host support we don't use; no fixed Testcontainers release yet. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.13.0" />
    <!-- IAsyncLifetime only — lets xUnit use OrdinisApiFactory directly as a collection fixture. -->
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ordinis.Api\Ordinis.Api.csproj" />
  </ItemGroup>

</Project>
